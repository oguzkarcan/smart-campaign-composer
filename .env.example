# Copy to .env and adjust. .env is gitignored; never commit real keys.

# LLM: "mock" (default, no key needed) or "claude"
LLM_MODE=mock
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Postgres
POSTGRES_USER=scc
POSTGRES_PASSWORD=scc
POSTGRES_DB=scc
DATABASE_URL=postgres://scc:scc@postgres:5432/scc?sslmode=disable

# Services
HTTP_ADDR=:8080
PROVIDER_URL=http://mockprovider:9090

# Mock provider misbehaviour (rates are probabilities per request)
MOCK_RATE_PER_SEC=100
MOCK_BURST=100
MOCK_RETRY_AFTER=1s
MOCK_THROTTLE_RATE=0.03
MOCK_ERROR_RATE=0.05
MOCK_LOST_RESPONSE_RATE=0.01
MOCK_MIN_LATENCY=20ms
MOCK_MAX_LATENCY=150ms
MOCK_SLOW_RATE=0.01
MOCK_SLOW_LATENCY=3s
