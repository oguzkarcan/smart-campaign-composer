# Copy to .env and adjust. .env is gitignored; never commit real keys.

# LLM: "mock" (default, no key needed) or "claude"
LLM_MODE=mock
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Postgres
POSTGRES_USER=scc
POSTGRES_PASSWORD=scc
POSTGRES_DB=scc
DATABASE_URL=postgres://scc:scc@postgres:5432/scc?sslmode=disable

# Services
HTTP_ADDR=:8080
PROVIDER_URL=http://mockprovider:9090
